# Database (Prisma + Neon)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
NEON_DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
NEON_DATABASE_URL_NON_POOLING="postgresql://user:password@host:5432/db?sslmode=require"
NEON_DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/db?sslmode=require"
POSTGRES_URL="postgresql://user:password@host:5432/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/db?sslmode=require"
DATABASE_URL_NON_POOLING="postgresql://user:password@host:5432/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/db?sslmode=require"

# Auth (Neon Auth)
NEON_AUTH_BASE_URL="https://auth.neon.tech/project/..."
NEON_AUTH_COOKIE_SECRET="super-long-random-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OTW_MODE="core"
OTW_CRON_SECRET="replace-with-long-random-secret"
OTW_BASE64_UPLOAD_OVERRIDE="false"

# Core feature flags
NEXT_PUBLIC_FEATURE_RECEIPTS="false"
NEXT_PUBLIC_FEATURE_PICKUP_PASS="true"
NEXT_PUBLIC_FEATURE_CHAT="true"

# Object storage (pickup-pass uploads)
STORAGE_PROVIDER="s3"
S3_BUCKET="otw-private-assets"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
# Optional for R2/custom S3-compatible endpoints:
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PLUS="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ELITE="price_..."
STRIPE_PRICE_BLACK="price_..."

# HCaptcha
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET_KEY="0x0000000000000000000000000000000000000000"

# Optional integrations
RESEND_API_KEY="re_..."
FROM_EMAIL="support@ontheway.app"
FROM_NAME="OTW"
SLACK_OTW_REQUESTS_WEBHOOK_URL="https://hooks.slack.com/services/..."
SLACK_OTW_INTAKE_WEBHOOK_URL="https://hooks.slack.com/services/..."
DISCORD_WEBHOOK_URL=
SENTRY_AUTH_TOKEN=
# Optional fan-out: comma-separated list (overrides ZAPIER_WEBHOOK_URL when set)
ZAPIER_WEBHOOK_URLS=https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/,https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/
